<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit <%= location.name %></title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>
    <form action="/locations/<%= location._id %>?_method=PUT" method="POST">
      <label for="name">Name:</label>
      <input type="text" name="name" id="name" value="<%= location.name %>"/>
      <label for="street">Street:</label>
      <input type="text" name="street" id="street" value="<%= location.street %>"/>
      <label for="city">City:</label>
      <input type="text" name="city" id="city" value="<%= location.city %>" />
      <button type="submit">Edit Location</button>
    </form>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Locations</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>
    <h1>Here's all the Locations</h1>
    <a href="/locations/new">Add a New Location</a>
    <ul>
      <% locations.forEach((location) => { %>
        <li>
          <a href="/locations/<%= location._id%>">
            <%= location.name%> in <%= location.city%>
          </a>
          owned by <%= location.owner.username %>.
        </li>
      <% }) %>
    </ul>
  </body>
</html>
